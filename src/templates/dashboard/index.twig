{% extends "_layouts/cp" %}

{% set title = "Sale Scheduler Dashboard"|t('commerce-sale-scheduler') %}
{% set selectedSubnavItem = 'dashboard' %}

{% block actionButton %}
    <a href="{{ cpUrl('sale-scheduler/sales/new') }}" class="btn submit add icon">{{ "Create Sale"|t('commerce-sale-scheduler') }}</a>
{% endblock %}

{% block content %}
    {# Stats Grid #}
    <div class="sale-scheduler-dashboard-grid">
        <div class="sale-stat-card">
            <div class="sale-stat-card__title">{{ "Total Sales"|t('commerce-sale-scheduler') }}</div>
            <div class="sale-stat-card__value">{{ stats.total }}</div>
        </div>

        <div class="sale-stat-card sale-stat-card--active" style="border-left: 4px solid #16a34a;">
            <div class="sale-stat-card__title" style="color:#16a34a;">{{ "Active Sales"|t('commerce-sale-scheduler') }}</div>
            <div class="sale-stat-card__value">{{ stats.active }}</div>
        </div>

        <div class="sale-stat-card sale-stat-card--scheduled" style="border-left: 4px solid #2563eb;">
            <div class="sale-stat-card__title" style="color:#2563eb;">{{ "Scheduled"|t('commerce-sale-scheduler') }}</div>
            <div class="sale-stat-card__value">{{ stats.scheduled }}</div>
        </div>

        <div class="sale-stat-card sale-stat-card--expiring" style="border-left: 4px solid #d97706;">
            <div class="sale-stat-card__title" style="color:#d97706;">{{ "Expiring Soon (48h)"|t('commerce-sale-scheduler') }}</div>
            <div class="sale-stat-card__value">{{ stats.expiringSoon }}</div>
        </div>

        <div class="sale-stat-card sale-stat-card--conflicts" style="border-left: 4px solid #dc2626;">
            <div class="sale-stat-card__title" style="color:#dc2626;">{{ "Pricing Conflicts"|t('commerce-sale-scheduler') }}</div>
            <div class="sale-stat-card__value">{{ stats.conflicts }}</div>
        </div>
    </div>

    {# Conflicts Notice #}
    {% if conflicts|length %}
        <div class="sale-conflict-box">
            <p style="font-weight:700; margin:0 0 6px 0;">⚠️ {{ "Pricing Conflicts Detected"|t('commerce-sale-scheduler') }}</p>
            <ul style="margin:0; padding-left:18px;">
                {% for conflict in conflicts %}
                    <li>
                        <strong>{{ conflict.sale1.name }}</strong> (Priority: {{ conflict.sale1.priority }}) and <strong>{{ conflict.sale2.name }}</strong> (Priority: {{ conflict.sale2.priority }}): {{ conflict.reason }}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {# Recent Sales Panel #}
    <div class="sale-panel">
        <div class="sale-panel-header">
            <div class="sale-panel-title-group">
                <span class="sale-panel-icon sale-panel-icon--blue">⏱️</span>
                <div>
                    <h3 class="sale-panel-title">{{ "Recently Updated Sales"|t('commerce-sale-scheduler') }}</h3>
                    <p class="sale-panel-subtitle">{{ "Latest promotional events configured in your store."|t('commerce-sale-scheduler') }}</p>
                </div>
            </div>
            <div>
                <a href="{{ cpUrl('sale-scheduler/sales') }}" class="btn small">{{ "View All Sales"|t('commerce-sale-scheduler') }} &rarr;</a>
            </div>
        </div>

        {% if recentSales|length %}
            <div style="overflow-x:auto;">
                <table class="data fullwidth" style="margin:0;">
                    <thead>
                        <tr>
                            <th scope="col">{{ "Sale Name"|t('commerce-sale-scheduler') }}</th>
                            <th scope="col">{{ "Status"|t('commerce-sale-scheduler') }}</th>
                            <th scope="col">{{ "Discount"|t('commerce-sale-scheduler') }}</th>
                            <th scope="col">{{ "Schedule"|t('commerce-sale-scheduler') }}</th>
                            <th scope="col">{{ "Priority"|t('commerce-sale-scheduler') }}</th>
                            <th scope="col" style="text-align:right;">{{ "Actions"|t('commerce-sale-scheduler') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for sale in recentSales %}
                            {% set status = sale.getStatus() %}
                            <tr>
                                <td>
                                    <a href="{{ cpUrl('sale-scheduler/sales/' ~ sale.id) }}" style="font-weight:600; color:#0f172a; text-decoration:none;">
                                        {{ sale.name }}
                                    </a>
                                    {% if sale.description %}
                                        <div class="light" style="font-size:12px; margin-top:2px;">{{ sale.description|slice(0, 80) }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="sale-status-badge sale-status-badge--{{ status }}">
                                        {{ sale.getStatusLabel() }}
                                    </span>
                                </td>
                                <td>
                                    <span style="display:inline-block; font-weight:700; background:#f1f5f9; padding:3px 8px; border-radius:6px; font-size:13px; color:#0f172a;">
                                        {{ sale.getFormattedDiscount() }}
                                    </span>
                                </td>
                                <td class="light" style="font-size:12px;">
                                    {% if sale.dateFrom or sale.dateTo %}
                                        <div><strong>{{ sale.dateFrom ? sale.dateFrom|date('short') : 'Immediate' }}</strong> &rarr; <strong>{{ sale.dateTo ? sale.dateTo|date('short') : 'Ongoing' }}</strong></div>
                                    {% else %}
                                        <span class="light">{{ "Always active"|t('commerce-sale-scheduler') }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge" style="font-size:11px;">{{ sale.priority }}</span>
                                </td>
                                <td style="text-align:right;">
                                    <a href="{{ cpUrl('sale-scheduler/sales/' ~ sale.id) }}" class="btn small">{{ "Edit"|t('commerce-sale-scheduler') }}</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="empty" style="text-align:center; padding:40px 20px;">
                <p class="light" style="margin-bottom:12px;">{{ "No sales configured yet."|t('commerce-sale-scheduler') }}</p>
                <a href="{{ cpUrl('sale-scheduler/sales/new') }}" class="btn submit add icon">{{ "Create your first sale"|t('commerce-sale-scheduler') }}</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
