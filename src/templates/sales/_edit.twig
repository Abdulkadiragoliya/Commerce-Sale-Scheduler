{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set selectedSubnavItem = 'sales' %}
{% set fullPageForm = true %}
{% set submitButtonLabel = 'Save Sale'|t('commerce-sale-scheduler') %}

{% block content %}
    {{ actionInput('commerce-sale-scheduler/sales/save') }}
    {{ redirectInput('sale-scheduler/sales') }}
    {% if sale.id %}
        <input type="hidden" name="id" value="{{ sale.id }}">
    {% endif %}

        {# 1. General Details Panel #}
        <div class="sale-panel">
            <div class="sale-panel-header">
                <div class="sale-panel-title-group">
                    <span class="sale-panel-icon sale-panel-icon--blue">🏷️</span>
                    <div>
                        <h3 class="sale-panel-title">{{ "General Details"|t('commerce-sale-scheduler') }}</h3>
                        <p class="sale-panel-subtitle">{{ "Basic identification, description, and execution priority."|t('commerce-sale-scheduler') }}</p>
                    </div>
                </div>
            </div>
            <div class="sale-panel-body">
                {{ forms.textField({
                    label: "Sale Name"|t('commerce-sale-scheduler'),
                    instructions: "Name of the sale for identification and badges."|t('commerce-sale-scheduler'),
                    id: 'name',
                    name: 'name',
                    value: sale.name,
                    errors: sale.getErrors('name'),
                    required: true,
                    autofocus: true
                }) }}

                {{ forms.textareaField({
                    label: "Internal Description"|t('commerce-sale-scheduler'),
                    instructions: "Optional administrative notes describing the purpose of this promotion."|t('commerce-sale-scheduler'),
                    id: 'description',
                    name: 'description',
                    value: sale.description,
                    rows: 2
                }) }}

                <div class="sale-grid-2">
                    {{ forms.lightswitchField({
                        label: "Enabled"|t('commerce-sale-scheduler'),
                        instructions: "Whether this sale is actively applied when date criteria are met."|t('commerce-sale-scheduler'),
                        id: 'enabled',
                        name: 'enabled',
                        on: sale.enabled
                    }) }}

                    {{ forms.textField({
                        label: "Priority"|t('commerce-sale-scheduler'),
                        instructions: "Tie-breaking priority integer. Higher number wins over lower priority sales."|t('commerce-sale-scheduler'),
                        id: 'priority',
                        name: 'priority',
                        type: 'number',
                        value: sale.priority,
                        size: 6
                    }) }}
                </div>
            </div>
        </div>

        {# 2. Schedule & Timing Panel #}
        <div class="sale-panel">
            <div class="sale-panel-header">
                <div class="sale-panel-title-group">
                    <span class="sale-panel-icon sale-panel-icon--amber">📅</span>
                    <div>
                        <h3 class="sale-panel-title">{{ "Schedule & Timing"|t('commerce-sale-scheduler') }}</h3>
                        <p class="sale-panel-subtitle">{{ "Specify when this promotion goes live and when it expires automatically."|t('commerce-sale-scheduler') }}</p>
                    </div>
                </div>
            </div>
            <div class="sale-panel-body">
                <div class="sale-grid-2">
                    {{ forms.dateTimeField({
                        label: "Start Date & Time"|t('commerce-sale-scheduler'),
                        instructions: "When the sale becomes active (optional; leave blank for immediate activation)."|t('commerce-sale-scheduler'),
                        id: 'dateFrom',
                        name: 'dateFrom',
                        value: sale.dateFrom,
                        errors: sale.getErrors('dateFrom')
                    }) }}

                    {{ forms.dateTimeField({
                        label: "End Date & Time"|t('commerce-sale-scheduler'),
                        instructions: "When the sale expires (optional; leave blank for an ongoing promotion)."|t('commerce-sale-scheduler'),
                        id: 'dateTo',
                        name: 'dateTo',
                        value: sale.dateTo,
                        errors: sale.getErrors('dateTo')
                    }) }}
                </div>
            </div>
        </div>

        {# 3. Discount Configuration Panel #}
        <div class="sale-panel">
            <div class="sale-panel-header">
                <div class="sale-panel-title-group">
                    <span class="sale-panel-icon sale-panel-icon--green">💰</span>
                    <div>
                        <h3 class="sale-panel-title">{{ "Discount Configuration"|t('commerce-sale-scheduler') }}</h3>
                        <p class="sale-panel-subtitle">{{ "Configure whether this discount is a percentage or fixed amount off."|t('commerce-sale-scheduler') }}</p>
                    </div>
                </div>
            </div>
            <div class="sale-panel-body">
                <div class="sale-grid-2">
                    {{ forms.selectField({
                        label: "Discount Type"|t('commerce-sale-scheduler'),
                        instructions: "Choose percentage off or fixed currency amount off."|t('commerce-sale-scheduler'),
                        id: 'discountType',
                        name: 'discountType',
                        value: sale.discountType,
                        options: [
                            { label: "Percentage (%) Off"|t('commerce-sale-scheduler'), value: 'percentage' },
                            { label: "Fixed Amount Off"|t('commerce-sale-scheduler'), value: 'fixed' }
                        ]
                    }) }}

                    {{ forms.textField({
                        label: "Discount Value"|t('commerce-sale-scheduler'),
                        instructions: "Percentage number (e.g. 20) or fixed currency amount (e.g. 15.00)."|t('commerce-sale-scheduler'),
                        id: 'discountValue',
                        name: 'discountValue',
                        type: 'number',
                        step: 'any',
                        value: sale.discountValue,
                        errors: sale.getErrors('discountValue'),
                        required: true
                    }) }}
                </div>
            </div>
        </div>

        {# 4. Targeting & Coverage Panel #}
        <div class="sale-panel">
            <div class="sale-panel-header">
                <div class="sale-panel-title-group">
                    <span class="sale-panel-icon sale-panel-icon--purple">🎯</span>
                    <div>
                        <h3 class="sale-panel-title">{{ "Targeting & Assignments"|t('commerce-sale-scheduler') }}</h3>
                        <p class="sale-panel-subtitle">{{ "Target products directly, individual variants, or whole categories. Exclusions always take highest precedence."|t('commerce-sale-scheduler') }}</p>
                    </div>
                </div>
            </div>
            <div class="sale-panel-body">
                {{ forms.elementSelectField({
                    label: "Target Products"|t('commerce-sale-scheduler'),
                    instructions: "Select products explicitly targeted by this sale."|t('commerce-sale-scheduler'),
                    id: 'productIds',
                    name: 'productIds',
                    elementType: 'craft\\commerce\\elements\\Product',
                    elements: sale.productIds ? craft.products.id(sale.productIds).all() : [],
                    limit: null
                }) }}

                {{ forms.lightswitchField({
                    label: "Apply to All Variants"|t('commerce-sale-scheduler'),
                    instructions: "When enabled, all variants of targeted products receive the discount."|t('commerce-sale-scheduler'),
                    id: 'applyToAllVariants',
                    name: 'applyToAllVariants',
                    on: sale.applyToAllVariants
                }) }}

                {{ forms.elementSelectField({
                    label: "Target Specific Variants (Optional)"|t('commerce-sale-scheduler'),
                    instructions: "Target individual variants specifically (takes highest precedence over products and categories)."|t('commerce-sale-scheduler'),
                    id: 'variantIds',
                    name: 'variantIds',
                    elementType: 'craft\\commerce\\elements\\Variant',
                    elements: sale.variantIds ? craft.variants.id(sale.variantIds).all() : [],
                    limit: null
                }) }}

                {{ forms.elementSelectField({
                    label: "Target Categories (Dynamic Category Sales)"|t('commerce-sale-scheduler'),
                    instructions: "Products in these categories automatically receive the sale. Newly categorized products are included dynamically."|t('commerce-sale-scheduler'),
                    id: 'categoryIds',
                    name: 'categoryIds',
                    elementType: 'craft\\elements\\Category',
                    elements: sale.categoryIds ? craft.categories.id(sale.categoryIds).all() : [],
                    limit: null
                }) }}

                {{ forms.elementSelectField({
                    label: "Product Exclusions"|t('commerce-sale-scheduler'),
                    instructions: "Products explicitly excluded from this sale even if they belong to targeted categories."|t('commerce-sale-scheduler'),
                    id: 'exclusionIds',
                    name: 'exclusionIds',
                    elementType: 'craft\\commerce\\elements\\Product',
                    elements: sale.exclusionIds ? craft.products.id(sale.exclusionIds).all() : [],
                    limit: null
                }) }}

                <div class="sale-coverage-badge">
                    <span>📊</span>
                    <span>
                        <strong>{{ "Estimated Coverage:"|t('commerce-sale-scheduler') }}</strong>
                        {{ affectedCounts.products }} {{ "product(s)"|t('commerce-sale-scheduler') }}, 
                        {{ affectedCounts.variants }} {{ "variant(s) affected."|t('commerce-sale-scheduler') }}
                    </span>
                </div>
            </div>
        </div>

        {# 5. Tag & Badge Settings Panel #}
        <div class="sale-panel">
            <div class="sale-panel-header">
                <div class="sale-panel-title-group">
                    <span class="sale-panel-icon sale-panel-icon--rose">🎨</span>
                    <div>
                        <h3 class="sale-panel-title">{{ "Promotional Tag & Badge Settings"|t('commerce-sale-scheduler') }}</h3>
                        <p class="sale-panel-subtitle">{{ "Configure the visual promotional badge displayed over product imagery."|t('commerce-sale-scheduler') }}</p>
                    </div>
                </div>
            </div>
            <div class="sale-panel-body">
                <div class="sale-grid-2">
                    {{ forms.lightswitchField({
                        label: "Enable Tag Badge"|t('commerce-sale-scheduler'),
                        instructions: "Display promotional badge/tag over product images."|t('commerce-sale-scheduler'),
                        id: 'tagEnabled',
                        name: 'tagEnabled',
                        on: sale.tagEnabled
                    }) }}

                    {{ forms.textField({
                        label: "Tag Badge Width / Size"|t('commerce-sale-scheduler'),
                        instructions: "CSS width (e.g. 80px or 25%)."|t('commerce-sale-scheduler'),
                        id: 'tagWidth',
                        name: 'tagWidth',
                        value: sale.tagWidth
                    }) }}
                </div>

                {{ forms.elementSelectField({
                    label: "Promotional Tag Image Asset"|t('commerce-sale-scheduler'),
                    instructions: "Select or upload an image asset (PNG, JPEG, WebP) to display as the promotional badge."|t('commerce-sale-scheduler'),
                    id: 'tagAssetId',
                    name: 'tagAssetId',
                    elementType: 'craft\\elements\\Asset',
                    elements: sale.tagAssetId ? craft.assets.id(sale.tagAssetId).all() : [],
                    limit: 1
                }) }}

                {{ forms.textField({
                    label: "Tag Label / Alt Text / Text Badge Fallback"|t('commerce-sale-scheduler'),
                    instructions: "Image alternative text, or text displayed if no image asset is selected (e.g. 'FLASH SALE' or '25% OFF')."|t('commerce-sale-scheduler'),
                    id: 'tagText',
                    name: 'tagText',
                    value: sale.tagText
                }) }}

                <div class="sale-grid-2">
                    {{ forms.selectField({
                        label: "Position on Listing Cards"|t('commerce-sale-scheduler'),
                        id: 'tagPositionListing',
                        name: 'tagPositionListing',
                        value: sale.tagPositionListing,
                        options: [
                            { label: "Top Right"|t('commerce-sale-scheduler'), value: 'top-right' },
                            { label: "Top Left"|t('commerce-sale-scheduler'), value: 'top-left' },
                            { label: "Bottom Right"|t('commerce-sale-scheduler'), value: 'bottom-right' },
                            { label: "Bottom Left"|t('commerce-sale-scheduler'), value: 'bottom-left' }
                        ]
                    }) }}

                    {{ forms.selectField({
                        label: "Position on Product Detail Page"|t('commerce-sale-scheduler'),
                        id: 'tagPositionDetail',
                        name: 'tagPositionDetail',
                        value: sale.tagPositionDetail,
                        options: [
                            { label: "Top Right"|t('commerce-sale-scheduler'), value: 'top-right' },
                            { label: "Top Left"|t('commerce-sale-scheduler'), value: 'top-left' },
                            { label: "Bottom Right"|t('commerce-sale-scheduler'), value: 'bottom-right' },
                            { label: "Bottom Left"|t('commerce-sale-scheduler'), value: 'bottom-left' }
                        ]
                    }) }}
                </div>
            </div>
        </div>

        {# 6. Countdown Timer Settings Panel #}
        <div class="sale-panel">
            <div class="sale-panel-header">
                <div class="sale-panel-title-group">
                    <span class="sale-panel-icon sale-panel-icon--blue">⏱️</span>
                    <div>
                        <h3 class="sale-panel-title">{{ "Countdown Timer Settings"|t('commerce-sale-scheduler') }}</h3>
                        <p class="sale-panel-subtitle">{{ "Drive urgency with an automated real-time countdown to sale expiry."|t('commerce-sale-scheduler') }}</p>
                    </div>
                </div>
            </div>
            <div class="sale-panel-body">
                <div class="sale-grid-2">
                    {{ forms.lightswitchField({
                        label: "Enable Countdown Timer"|t('commerce-sale-scheduler'),
                        instructions: "Show countdown until sale expiration date."|t('commerce-sale-scheduler'),
                        id: 'countdownEnabled',
                        name: 'countdownEnabled',
                        on: sale.countdownEnabled
                    }) }}

                    {{ forms.selectField({
                        label: "Countdown Style"|t('commerce-sale-scheduler'),
                        id: 'countdownStyle',
                        name: 'countdownStyle',
                        value: sale.countdownStyle,
                        options: [
                            { label: "Compact Style"|t('commerce-sale-scheduler'), value: 'compact' },
                            { label: "Boxed Dark Style"|t('commerce-sale-scheduler'), value: 'boxed' },
                            { label: "Minimal Style"|t('commerce-sale-scheduler'), value: 'minimal' }
                        ]
                    }) }}
                </div>

                {{ forms.textField({
                    label: "Countdown Heading"|t('commerce-sale-scheduler'),
                    instructions: "Custom title (e.g. 'Hurry, Sale Ends In:')."|t('commerce-sale-scheduler'),
                    id: 'countdownHeading',
                    name: 'countdownHeading',
                    value: sale.countdownHeading
                }) }}

                <div class="sale-grid-2">
                    {{ forms.colorField({
                        label: "Countdown Heading Font Color"|t('commerce-sale-scheduler'),
                        instructions: "Custom font color for the countdown heading text and clock icon."|t('commerce-sale-scheduler'),
                        id: 'countdownHeadingColor',
                        name: 'countdownHeadingColor',
                        value: sale.countdownHeadingColor
                    }) }}

                    {{ forms.colorField({
                        label: "Countdown Style Font / Digits Color"|t('commerce-sale-scheduler'),
                        instructions: "Custom font color for timer digits, colons, and unit labels."|t('commerce-sale-scheduler'),
                        id: 'countdownDigitsColor',
                        name: 'countdownDigitsColor',
                        value: sale.countdownDigitsColor
                    }) }}
                </div>

                <div class="sale-grid-2">
                    {{ forms.lightswitchField({
                        label: "Show on Product Detail Page"|t('commerce-sale-scheduler'),
                        id: 'countdownShowDetail',
                        name: 'countdownShowDetail',
                        on: sale.countdownShowDetail
                    }) }}

                    {{ forms.lightswitchField({
                        label: "Show on Product Listing Cards"|t('commerce-sale-scheduler'),
                        id: 'countdownShowListing',
                        name: 'countdownShowListing',
                        on: sale.countdownShowListing
                    }) }}
                </div>
            </div>
        </div>

        {# 7. Storefront Price Display Options Panel #}
        <div class="sale-panel">
            <div class="sale-panel-header">
                <div class="sale-panel-title-group">
                    <span class="sale-panel-icon sale-panel-icon--slate">👁️</span>
                    <div>
                        <h3 class="sale-panel-title">{{ "Storefront Price Display Options"|t('commerce-sale-scheduler') }}</h3>
                        <p class="sale-panel-subtitle">{{ "Control which price comparisons, savings amounts, and badges are rendered."|t('commerce-sale-scheduler') }}</p>
                    </div>
                </div>
            </div>
            <div class="sale-panel-body">
                <div class="sale-grid-3">
                    {{ forms.lightswitchField({
                        label: "Show Strikethrough Original Price"|t('commerce-sale-scheduler'),
                        id: 'priceShowOriginal',
                        name: 'priceShowOriginal',
                        on: sale.priceShowOriginal
                    }) }}

                    {{ forms.lightswitchField({
                        label: "Show Savings Amount & Percent"|t('commerce-sale-scheduler'),
                        id: 'priceShowSavings',
                        name: 'priceShowSavings',
                        on: sale.priceShowSavings
                    }) }}

                    {{ forms.lightswitchField({
                        label: "Show Promo Badge"|t('commerce-sale-scheduler'),
                        id: 'priceShowBadge',
                        name: 'priceShowBadge',
                        on: sale.priceShowBadge
                    }) }}
                </div>

                {{ forms.textField({
                    label: "Custom Discount Badge Text (Optional)"|t('commerce-sale-scheduler'),
                    instructions: "Override default 'Save X%' with custom copy (e.g. 'SPECIAL DEAL')."|t('commerce-sale-scheduler'),
                    id: 'badgeText',
                    name: 'badgeText',
                    value: sale.badgeText
                }) }}
            </div>
        </div>

        {# Form Submit / Cancel / Delete Actions #}
        <div class="sale-form-actions" style="display:flex; justify-content:space-between; align-items:center;">
            <div style="display:flex; gap:10px;">
                <input type="submit" class="btn submit big" value="{{ 'Save Sale'|t('commerce-sale-scheduler') }}">
                <a href="{{ cpUrl('sale-scheduler/sales') }}" class="btn big">{{ 'Cancel'|t('commerce-sale-scheduler') }}</a>
            </div>
            {% if sale.id %}
                <div>
                    <button type="submit" formaction="{{ actionUrl('commerce-sale-scheduler/sales/delete', { id: sale.id }) }}" class="btn big error" onclick="return confirm('{{ 'Are you sure you want to permanently delete this sale?'|t('commerce-sale-scheduler')|e('js') }}');">
                        {{ 'Delete Sale'|t('commerce-sale-scheduler') }}
                    </button>
                </div>
            {% endif %}
        </div>
{% endblock %}
