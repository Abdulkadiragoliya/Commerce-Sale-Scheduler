{% extends "_layouts/cp" %}

{% set title = "Scheduled Sales"|t('commerce-sale-scheduler') %}
{% set selectedSubnavItem = 'sales' %}

{% block actionButton %}
    <a href="{{ cpUrl('sale-scheduler/sales/new') }}" class="btn submit add icon">{{ "Create Sale"|t('commerce-sale-scheduler') }}</a>
{% endblock %}

{% block content %}
    {# Search & Filter Toolbar #}
    <div class="toolbar" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
        <form method="get" action="" style="display:flex; gap:10px; align-items:center;">
            <div class="texticon search icon">
                <input type="text" name="search" value="{{ search }}" class="text" placeholder="{{ 'Search sales…'|t('commerce-sale-scheduler') }}" />
            </div>

            <div class="select">
                <select name="status" onchange="this.form.submit()">
                    <option value="all" {{ status == 'all' ? 'selected' : '' }}>{{ "All Statuses"|t('commerce-sale-scheduler') }}</option>
                    <option value="active" {{ status == 'active' ? 'selected' : '' }}>{{ "Active"|t('commerce-sale-scheduler') }}</option>
                    <option value="scheduled" {{ status == 'scheduled' ? 'selected' : '' }}>{{ "Scheduled"|t('commerce-sale-scheduler') }}</option>
                    <option value="expired" {{ status == 'expired' ? 'selected' : '' }}>{{ "Expired"|t('commerce-sale-scheduler') }}</option>
                    <option value="disabled" {{ status == 'disabled' ? 'selected' : '' }}>{{ "Disabled"|t('commerce-sale-scheduler') }}</option>
                </select>
            </div>

            <input type="submit" class="btn" value="{{ 'Filter'|t('commerce-sale-scheduler') }}" />
        </form>
    </div>

    {# Bulk Actions Form & Table #}
    <form method="post" action="" id="sales-form">
        {{ csrfInput() }}
        {{ actionInput('commerce-sale-scheduler/sales/bulk-action') }}

        {% if sales|length %}
            <div style="margin-bottom:12px; display:flex; gap:8px; align-items:center;">
                <div class="select">
                    <select name="bulkAction">
                        <option value="">{{ "Bulk Actions…"|t('commerce-sale-scheduler') }}</option>
                        <option value="enable">{{ "Enable Selected"|t('commerce-sale-scheduler') }}</option>
                        <option value="disable">{{ "Disable Selected"|t('commerce-sale-scheduler') }}</option>
                        <option value="delete">{{ "Delete Selected"|t('commerce-sale-scheduler') }}</option>
                    </select>
                </div>
                <input type="submit" class="btn" value="{{ 'Apply'|t('commerce-sale-scheduler') }}" onclick="return confirm('{{ 'Are you sure you want to perform this action on selected sales?'|t('commerce-sale-scheduler') }}');" />
            </div>

            <table class="data fullwidth" id="sales-table">
                <thead>
                    <tr>
                        <th style="width:20px;">
                            <input type="checkbox" id="select-all" onclick="var c=document.querySelectorAll('.sale-cb'); for(var i=0;i<c.length;i++) c[i].checked=this.checked;" />
                        </th>
                        <th scope="col">{{ "Sale Name"|t('commerce-sale-scheduler') }}</th>
                        <th scope="col">{{ "Status"|t('commerce-sale-scheduler') }}</th>
                        <th scope="col">{{ "Discount"|t('commerce-sale-scheduler') }}</th>
                        <th scope="col">{{ "Schedule"|t('commerce-sale-scheduler') }}</th>
                        <th scope="col">{{ "Priority"|t('commerce-sale-scheduler') }}</th>
                        <th scope="col" style="text-align:right;">{{ "Actions"|t('commerce-sale-scheduler') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for sale in sales %}
                        {% set s = sale.getStatus() %}
                        <tr>
                            <td>
                                <input type="checkbox" name="ids[]" value="{{ sale.id }}" class="sale-cb" />
                            </td>
                            <td>
                                <a href="{{ cpUrl('sale-scheduler/sales/' ~ sale.id) }}"><strong>{{ sale.name }}</strong></a>
                                {% if sale.description %}
                                    <div class="light" style="font-size:12px;">{{ sale.description|slice(0, 70) }}</div>
                                {% endif %}
                            </td>
                            <td>
                                <span class="status {{ s == 'active' ? 'green' : (s == 'scheduled' ? 'blue' : (s == 'expired' ? 'disabled' : 'red')) }}"></span>
                                {{ sale.getStatusLabel() }}
                            </td>
                            <td>
                                <code>{{ sale.getFormattedDiscount() }}</code>
                            </td>
                            <td class="light" style="font-size:12px;">
                                {% if sale.dateFrom or sale.dateTo %}
                                    {{ sale.dateFrom ? sale.dateFrom|date('short') : 'Anytime' }} &rarr; {{ sale.dateTo ? sale.dateTo|date('short') : 'Ongoing' }}
                                {% else %}
                                    {{ "Always active"|t('commerce-sale-scheduler') }}
                                {% endif %}
                            </td>
                            <td>
                                {{ sale.priority }}
                            </td>
                            <td style="text-align:right;">
                                <div style="display:inline-flex; gap:6px;">
                                    <a href="{{ cpUrl('sale-scheduler/sales/' ~ sale.id) }}" class="btn small">{{ "Edit"|t('commerce-sale-scheduler') }}</a>
                                    
                                    <button type="submit" formaction="{{ actionUrl('commerce-sale-scheduler/sales/duplicate', { id: sale.id }) }}" class="btn small">
                                        {{ "Duplicate"|t('commerce-sale-scheduler') }}
                                    </button>

                                    <button type="submit" formaction="{{ actionUrl('commerce-sale-scheduler/sales/delete', { id: sale.id }) }}" class="btn small error" onclick="return confirm('{{ 'Are you sure you want to delete this sale?'|t('commerce-sale-scheduler') }}');">
                                        {{ "Delete"|t('commerce-sale-scheduler') }}
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="empty" style="text-align:center; padding:40px 20px;">
                <p class="light" style="font-size:15px; margin-bottom:12px;">{{ "No sales found matching your criteria."|t('commerce-sale-scheduler') }}</p>
                <a href="{{ cpUrl('sale-scheduler/sales/new') }}" class="btn submit">{{ "Create New Sale"|t('commerce-sale-scheduler') }}</a>
            </div>
        {% endif %}
    </form>
{% endblock %}
